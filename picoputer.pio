; Recent link-interface integration notes
; ---------------------------------------
; The electrical link is non-inverted and idle low. LinkIn and LinkOut run at
; eight PIO cycles per bit; with a 160-MHz state-machine clock this gives the
; required 20-Mbit/s link rate (50 ns per bit). The Clock generator is a
; separate 5-MHz state machine and is not stopped during simulated reset.
;
; Picoputer PIO programs
;
;--------------------------------------------------------------------------------
; 5 Mhz Clock
;--------------------------------------------------------------------------------

; the pin should be mapped to the GPIO that drives the 5 MHz clock pin.

.program picoputerclk
    set pindirs, 1   ; Set pin to output

.wrap_target
    set pins, 1      ; Drive pin high
    set pins, 0      ; Drive pin low
 .wrap

% c-sdk {
// this is a raw helper function for use by the user which sets up the GPIO output, and configures the SM to output on a particular pin

void picoputerclk_program_init(PIO pio, uint sm, uint offset, uint pin) {
    pio_gpio_init(pio, pin);
    pio_sm_set_consecutive_pindirs(pio, sm, pin, 1, true);
    pio_sm_config c = picoputerclk_program_get_default_config(offset);
    sm_config_set_set_pins(&c, pin, 1);

    // divider = 160 MHz / (2 × 5 MHz) = 16
    // So clock pin should show:
    // Frequency: 5 MHz Period:    200 ns
    float div = (float)clock_get_hz(clk_sys) / (2.0f * (float)TP3_C011_CLOCK_HZ);
    sm_config_set_clkdiv(&c, div);

    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}
%}

;--------------------------------------------------------------------------------
; Link Out
;--------------------------------------------------------------------------------
;
; Packets are:
;
; ACK:   10
; Data:  11XXXXXXXX0
;
; Clock is nominally 30MHz, 10Mhz for slower links
;
; LinkOut packet ownership:
;   - PIO generates the first high start/ACK bit.
;   - TX FIFO supplies ten LSB-first positions.
;   - A zero FIFO word therefore produces a valid H-L ACK and low idle tail.
;
.program picoputerlinkout

.side_set 1 opt


; The line is idle low. The first high start bit is generated by the PIO.
; The TX FIFO supplies the following ten bit positions, LSB first:
;
;   data: bit 0 = second start bit (1)
;         bits 1..8 = D0..D7
;         bit 9 = stop bit (0)
;
;   ACK:  all supplied bits are 0, so the physical waveform is H L.

    nop        side 0       ; Start with LinkOut in its low idle state
stopidle:

    pull       side 0 [7]   ; Stall with the line low until a packet is queued
    set x, 9   side 1 [7]   ; First high start bit for exactly one link bit

bitloop:
    out pins, 1             ; Shift one supplied bit, LSB first
    jmp x-- bitloop   [6]   ; Ten bits, eight PIO cycles per bit
    jmp stopidle side 0 [7] ; Return explicitly to the low idle state

% c-sdk {
//#include "hardware/clocks.h"
//#include "hardware/gpio.h"
//#include "pico_transputer_config.h"

/*
 * Reset reuses this helper to restart the state machine at the program entry.
 * Establishing the output latch as low before enabling PIO prevents a spurious
 * start/ACK pulse during startup or reset release.
 */
static inline void picoputerlinkout_program_init(PIO pio, uint sm, uint offset, uint pin_linkout) {
    /*
     * Establish the INMOS idle level before the GPIO is handed to the PIO.
     * This prevents LinkOut floating or briefly going high during startup.
     */
    gpio_init(pin_linkout);
    gpio_put(pin_linkout, 0);
    gpio_set_dir(pin_linkout, GPIO_OUT);

    pio_gpio_init(pio, pin_linkout);

    pio_sm_config c = picoputerlinkout_program_get_default_config(offset);

    // OUT shifts to right, no autopull
    sm_config_set_out_shift(&c, true, false, 32);

    // We are mapping both OUT and side-set to the same pin, because sometimes
    // we need to assert user data onto the pin (with OUT) and sometimes
    // assert constant values (start/stop bit)
    sm_config_set_out_pins(&c, pin_linkout, 1);
    sm_config_set_sideset_pins(&c, pin_linkout);

    // We only need TX, so get an 8-deep FIFO!
    // sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_TX);

    // SM transmits 1 bit per 8 execution cycles. We therefore use a
    // clock of 80MHz
    // float div = (float)clock_get_hz(clk_sys) / 80000000;
    // sm_config_set_clkdiv(&c, div);
    // changed to 160 MHz for 20 Mbit/s link
    float div = (float)clock_get_hz(clk_sys) / (float)TP3_LINK_PIO_CLOCK_HZ;
    hard_assert(div >= 1.0f);
    sm_config_set_clkdiv(&c, div);

    pio_sm_init(pio, sm, offset, &c);

    /* Set the PIO output latch and direction while the state machine is stopped. */
    pio_sm_set_pins_with_mask(pio, sm, 0u, 1u << pin_linkout);
    pio_sm_set_pindirs_with_mask(pio, sm,
                                  1u << pin_linkout,
                                  1u << pin_linkout);

    pio_sm_set_enabled(pio, sm, true);
}

// Queue one encoded link packet payload for the LinkOut PIO state machine.
// The PIO itself generates the first high start bit.
//
void picoputerlinkout_program_putc(PIO pio, uint sm, int c)
{
  pio_sm_put_blocking(pio, sm, (uint32_t)c);
}


%}


////////////////////////////////////////////////////////////////////////////////
//
// LinkIn
//
////////////////////////////////////////////////////////////////////////////////

; LinkIn synchronization:
;   - first wait confirms the low idle state;
;   - second wait detects the first rising start edge;
;   - the delay centers the first sample in the second start bit;
;   - ten samples capture start2, D0..D7 and the low stop bit.
;
.program picoputerlinkin

; IN pin 0 and JMP pin are both mapped to the GPIO used as linkin.

start:
    wait 0 pin 0        ; Ensure that the line is in its normal low idle state
    wait 1 pin 0        ; Trigger on the low-to-high edge of the first start bit
    set x, 9    [10]    ; Delay 12 PIO cycles from the edge: sample halfway through bit 2

; The first start bit is used only for edge detection. Sample the remaining
; ten bit positions: second start bit, eight data bits and the low stop bit.

bitloop:
    in pins, 1          ; Shift one sampled link bit into ISR
    jmp x-- bitloop [6] ; Ten samples, exactly eight PIO cycles per link bit

good_stop:             ; Framing validation will be added after basic RX works.
    push                ; Push the ten captured bits to the RX FIFO.


% c-sdk {
//#include "hardware/clocks.h"
//#include "hardware/gpio.h"
//#include "pico_transputer_config.h"

/*
 * Reset reuses this helper after notReset is released.  The pull-down matches
 * the physical low idle state and avoids a false rising-edge start detection
 * while the external driver is disconnected or tri-stated.
 */
static inline void picoputerlinkin_program_init(PIO pio, uint sm, uint offset, uint pin) {
    pio_sm_set_consecutive_pindirs(pio, sm, pin, 1, false);
    pio_gpio_init(pio, pin);
    gpio_pull_down(pin);

    pio_sm_config c = picoputerlinkin_program_get_default_config(offset);
    sm_config_set_in_pins(&c, pin); // for WAIT, IN
    sm_config_set_jmp_pin(&c, pin); // for JMP

    // Shift to right, autopush disabled. The ten sampled bits end up in
    // ISR[31:22], with the second start bit becoming bit 22.
    sm_config_set_in_shift(&c, true, false, 32);

    // SM transmits 1 bit per 8 execution cycles.
    // changed to 160 MHz for 20 Mbit/s link
    float div = (float)clock_get_hz(clk_sys) / (float)TP3_LINK_PIO_CLOCK_HZ;
    hard_assert(div >= 1.0f);
    sm_config_set_clkdiv(&c, div);

    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}

 uint32_t picoputerlinkin_get(PIO pio, uint sm)
{
  // read entire FIFO word
  io_rw_32 *rxfifo_shift = (io_rw_32*)&pio->rxf[sm];
  if (pio_sm_is_rx_fifo_empty(pio, sm))
    {
      // 0 indicates no data
      return 0;
    }

  // Set LSB to indicate data present
  return ((uint32_t)*rxfifo_shift) | 1;
}

%}
